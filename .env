# Configuración de Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_inventory
DB_CHARSET=utf8mb4

# Configuración de Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Configuración de Sesión
SESSION_LIFETIME=7200

# Configuración de Logs
LOG_LEVEL=debug
LOG_FILE=logs/app.log